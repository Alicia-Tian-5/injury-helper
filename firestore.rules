rules_version = '2';

// Shared cases are public: anyone can read them and post a new one, but no
// one can change or delete a case from the website (only from the Firebase
// console). Every field is checked here because posts appear immediately.
// Limits and injury ids must match share.js and triage.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cases/{caseId} {
      allow read: if true;
      allow create: if isValidCase(request.resource.data);
      allow update, delete: if false;
    }

    // Group chat: one room per injury. Only signed-in people with a verified
    // email can read or post, always under their own account; no one can
    // change or delete a message from the website. Limits must match
    // group-chat.js.
    match /rooms/{room}/messages/{messageId} {
      allow read: if isVerified() && isInjury(room);
      allow create: if isVerified() && isInjury(room) && isValidMessage(request.resource.data);
      allow update, delete: if false;
    }

    // Reports of harmful messages: anyone signed in can file one, and only
    // the site owner reads them, in the Firebase console.
    match /reports/{reportId} {
      allow create: if isVerified() && isValidReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // Nicknames, so friends see each other's name. Each person writes only
    // their own; limits must match group-chat.js.
    match /profiles/{uid} {
      allow read: if isVerified();
      allow create, update: if isVerified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.keys().hasAll(['nickname'])
        && isText(request.resource.data.nickname, 1, 20);
      allow delete: if false;
    }

    // A friend request is seen only by the two people in it; either can
    // remove it (to accept, decline or take it back). Only someone with a
    // nickname can be asked, and not by someone they blocked.
    match /friendRequests/{requestId} {
      allow read, delete: if isVerified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isVerified() && isValidRequest(requestId, request.resource.data);
      allow update: if false;
    }

    // A friendship is made by the person who accepts a request, and either
    // friend can end it. Its id is both account ids, smaller first. Sending a
    // private message updates who wrote last and when, nothing else.
    match /friendships/{friendshipId} {
      allow read, delete: if isVerified() && request.auth.uid in resource.data.members;
      allow create: if isVerified() && isValidFriendship(friendshipId, request.resource.data);
      allow update: if isVerified() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSender', 'lastMessageAt'])
        && request.resource.data.lastSender == request.auth.uid
        && request.resource.data.lastMessageAt == request.time;

      // Private messages: only the two friends, and only while they are friends.
      match /messages/{messageId} {
        allow read: if isFriend(friendshipId);
        allow create: if isFriend(friendshipId) && isValidPrivateMessage(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Blocking: only the person who blocked sees or removes it. A blocked
    // person cannot ask the blocker to be friends again.
    match /blocks/{blockId} {
      allow read, delete: if isVerified() && resource.data.blocker == request.auth.uid;
      allow create: if isVerified() && isValidBlock(blockId, request.resource.data);
      allow update: if false;
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isInjury(id) {
      return id in ['ankle', 'patella', 'sprain', 'strain', 'dislocation', 'fracture', 'concussion', 'bruise', 'wound', 'cramp', 'overuse', 'heat'];
    }

    function isValidMessage(m) {
      return m.keys().hasOnly(['uid', 'nickname', 'text', 'createdAt'])
        && m.keys().hasAll(['uid', 'nickname', 'text', 'createdAt'])
        && m.uid == request.auth.uid
        && isText(m.nickname, 1, 20)
        && isText(m.text, 1, 500)
        && m.createdAt == request.time;
    }

    function isValidRequest(requestId, r) {
      return r.keys().hasOnly(['from', 'to', 'createdAt'])
        && r.keys().hasAll(['from', 'to', 'createdAt'])
        && r.from == request.auth.uid
        && r.to is string
        && r.to != r.from
        && requestId == r.from + '_' + r.to
        && r.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(r.to))
        && !exists(/databases/$(database)/documents/blocks/$(r.to + '_' + r.from));
    }

    function isValidBlock(blockId, b) {
      return b.keys().hasOnly(['blocker', 'blocked', 'createdAt'])
        && b.keys().hasAll(['blocker', 'blocked', 'createdAt'])
        && b.blocker == request.auth.uid
        && b.blocked is string
        && b.blocked != b.blocker
        && blockId == b.blocker + '_' + b.blocked
        && b.createdAt == request.time;
    }

    // Allowed only when the other person asked this one to be friends.
    function isValidFriendship(friendshipId, f) {
      return f.keys().hasOnly(['members', 'createdAt'])
        && f.keys().hasAll(['members', 'createdAt'])
        && f.members is list
        && f.members.size() == 2
        && f.members[0] < f.members[1]
        && friendshipId == f.members[0] + '_' + f.members[1]
        && f.createdAt == request.time
        && !exists(/databases/$(database)/documents/blocks/$(f.members[0] + '_' + f.members[1]))
        && !exists(/databases/$(database)/documents/blocks/$(f.members[1] + '_' + f.members[0]))
        && ((f.members[0] == request.auth.uid
            && exists(/databases/$(database)/documents/friendRequests/$(f.members[1] + '_' + f.members[0])))
          || (f.members[1] == request.auth.uid
            && exists(/databases/$(database)/documents/friendRequests/$(f.members[0] + '_' + f.members[1]))));
    }

    function isFriend(friendshipId) {
      return isVerified()
        && exists(/databases/$(database)/documents/friendships/$(friendshipId))
        && request.auth.uid in get(/databases/$(database)/documents/friendships/$(friendshipId)).data.members;
    }

    function isValidPrivateMessage(m) {
      return m.keys().hasOnly(['uid', 'text', 'createdAt'])
        && m.keys().hasAll(['uid', 'text', 'createdAt'])
        && m.uid == request.auth.uid
        && isText(m.text, 1, 500)
        && m.createdAt == request.time;
    }

    function isValidReport(r) {
      return r.keys().hasOnly(['room', 'messageId', 'reporter', 'createdAt'])
        && r.keys().hasAll(['room', 'messageId', 'reporter', 'createdAt'])
        && isInjury(r.room)
        && isText(r.messageId, 1, 100)
        && r.reporter == request.auth.uid
        && r.createdAt == request.time;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isValidCase(c) {
      return c.keys().hasOnly(['injury', 'lang', 'nickname', 'story', 'treatment', 'recovery', 'lesson', 'createdAt'])
        && c.keys().hasAll(['injury', 'lang', 'nickname', 'story', 'treatment', 'recovery', 'lesson', 'createdAt'])
        && isInjury(c.injury)
        && c.lang in ['zh', 'en']
        && isText(c.nickname, 0, 30)
        && isText(c.story, 10, 1000)
        && isText(c.treatment, 0, 1000)
        && isText(c.recovery, 0, 200)
        && isText(c.lesson, 0, 500)
        && c.createdAt == request.time;
    }
  }
}
